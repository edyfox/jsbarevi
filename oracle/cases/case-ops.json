        "col": 1
      }
    },
    {
      "name": "gUip uppercases the paragraph's lines",
      "input": "aa bb\ncc dd\n\nee\n",
      "keys": "gUip<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "AA BB\nCC DD\n\nee\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gUb goes backwards",
      "input": "alpha beta gamma\n",
      "keys": "wgUb<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "ALPHA beta gamma\n",
        "line": 1,
        "col": 1
      }
    },
    {
