      "engines": [
        "vim"
      ],
      "expect": {
        "text": "\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gUi\" inside a quoted string",
      "input": "x \"ab cd\" y\n",
      "keys": "fagUi\"<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "x \"AB CD\" y\n",
