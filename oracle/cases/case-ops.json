        "vim"
      ],
      "expect": {
        "text": "uryyb world\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g?? rotates the whole line",
      "input": "hello world\n",
      "keys": "g??<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "uryyb jbeyq\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g?g? is the long form",
      "input": "hello world\n",
      "keys": "g?g?<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "uryyb jbeyq\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g?$ rotates to the end of the line",
      "input": "hello world\n",
      "keys": "g?$<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "uryyb jbeyq\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g? rotates letters only, keeping case",
      "input": "abc123-XYZ_!\n",
