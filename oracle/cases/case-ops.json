{
  "about": "gu / gU / g~ (and g? = rot13, the same letter-map rule) as OPERATORS: the motion form, a text object, the doubled line form (guu/gUU/g~~), counts on both sides of the operator, g/G as motions, and the visual form u/U/~. Only LETTERS change; the cursor lands on the start of the range; registers are untouched, and an all-uppercase gUiw changes no text (so it costs no undo step). Three cases are deliberately absent because they do not match: `.` replay of a case operator (recorded as an absolute range, the same approximation dw already has), and a case op over a quote object from OUTSIDE the quotes (our text object does not search forward — ci\"/di\" differ the same way). See docs/ENGINE.md.",
  "cases": [
    {
      "name": "gUiw uppercases a word",
      "input": "alpha beta\n",
      "keys": "gUiw<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "ALPHA beta\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gUiw leaves the cursor at the start of the word",
      "input": "alpha beta gamma\n",
      "keys": "wgUiw<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "alpha BETA gamma\n",
        "line": 1,
        "col": 7
      }
    },
    {
      "name": "gUw",
      "input": "alpha beta\n",
      "keys": "wgUw<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "alpha BETA\n",
        "line": 1,
        "col": 7
      }
    },
    {
      "name": "gUe",
      "input": "alpha beta\n",
      "keys": "gUe<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "ALPHA beta\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gU$ uppercases to the end of the line",
      "input": "alpha beta\n",
      "keys": "gU$<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "ALPHA BETA\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gUU uppercases the whole line",
      "input": "alpha beta\n",
      "keys": "gUU<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "ALPHA BETA\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "only letters change under gUU",
      "input": "a1-b_2\n",
      "keys": "gUU<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "A1-B_2\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "guu lowercases the line",
      "input": "ALPHA BETA\n",
      "keys": "guu<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "alpha beta\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g~~ toggles the line's case",
      "input": "Alpha Beta\n",
      "keys": "g~~<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "aLPHA bETA\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g~ toggles only letters",
      "input": "a1-b_2\n",
      "keys": "g~~<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "A1-B_2\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g~w toggles a word",
      "input": "Alpha Beta\n",
      "keys": "g~w<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "aLPHA Beta\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g~$ toggles to the end of the line",
      "input": "Ab Cd\n",
      "keys": "g~$<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "aB cD\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "g~l toggles one character",
      "input": "abc\n",
      "keys": "g~l<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "Abc\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gUj covers two lines",
      "input": "alpha\nbeta\ngamma\n",
      "keys": "gUj<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "ALPHA\nBETA\ngamma\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "3gUw takes a count before the operator",
      "input": "a b c d\n",
      "keys": "3gUw<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "A B C d\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gU2w takes a count after the operator",
      "input": "a b c d\n",
      "keys": "gU2w<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "A B c d\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gUap uppercases a paragraph",
