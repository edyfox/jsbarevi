        "col": 1
      }
    },
    {
      "name": "gUgg back to the start of the buffer",
      "input": "ab\ncd\nef\n",
      "keys": "jgUgg<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "AB\nCD\nef\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gUiw on text that is already upper changes nothing",
      "input": "ALPHA beta\n",
      "keys": "gUiw<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "ALPHA beta\n",
        "line": 1,
        "col": 1
