        "line": 1,
        "col": 1
      }
    },
    {
      "name": "2gUU uppercases two lines",
      "input": "ab\ncd\nef\n",
      "keys": "2gUU<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "AB\nCD\nef\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "gUG to the end of the buffer",
      "input": "ab\ncd\nef\n",
      "keys": "gUG<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "AB\nCD\nEF\n",
