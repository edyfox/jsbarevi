{
  "about": "Insert-mode C-w and C-u. Two rules here are not guessable from the documentation and were measured before the engine was written: C-w's scan never crosses a line start, and the insert start becomes a wall as soon as anything is typed. vim's LINE JOIN at column 1 is deliberately NOT implemented (docs/ENGINE.md, \"what is deliberately not covered\"), so no case here presses C-w or C-u at column 1 with a line above. Caret keys are included because the HOST owns the caret in insert mode (<Left>/<Right> move it, the adapter syncs it), so C-w/C-u must behave sanely after one. Each case is Esc-terminated so vim reports a normal-mode position - inside insert mode vim's col('.') is the insertion offset, which is one more than the character under the cursor.",
  "cases": [
    {
      "name": "C-w deletes the word before the cursor",
      "input": "foo bar\n",
      "keys": "A<C-w><Esc>",
      "expect": {
        "text": "foo \n",
        "line": 1,
        "col": 4
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "a second C-w deletes the word before that",
      "input": "foo bar\n",
      "keys": "A<C-w><C-w><Esc>",
      "expect": {
        "text": "\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w with nothing typed crosses the insert start",
      "input": "foo bar\n",
      "keys": "wi<C-w><Esc>",
      "expect": {
        "text": "bar\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w stops at the insert start once text is typed",
      "input": "foo bar\n",
      "keys": "AXY<C-w><Esc>",
      "expect": {
        "text": "foo bar\n",
        "line": 1,
        "col": 7
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w then typing continues at the insert start",
      "input": "foo bar\n",
      "keys": "AXY<C-w>Z<Esc>",
      "expect": {
        "text": "foo barZ\n",
        "line": 1,
        "col": 8
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "typed whitespace is still the typed run",
      "input": "ab\n",
      "keys": "A   <C-w><Esc>",
      "expect": {
        "text": "ab\n",
        "line": 1,
        "col": 2
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w takes trailing whitespace with the word",
      "input": "foo   \n",
      "keys": "A<C-w><Esc>",
      "expect": {
        "text": "\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w on a whitespace-only line empties it",
      "input": "    \n",
      "keys": "A<C-w><Esc>",
      "expect": {
        "text": "\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "punctuation is its own word for C-w",
      "input": "foo.bar\n",
      "keys": "A<C-w><Esc>",
      "expect": {
        "text": "foo.\n",
        "line": 1,
        "col": 4
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "underscore is a keyword character",
      "input": "foo_bar_baz\n",
      "keys": "A<C-w><Esc>",
      "expect": {
        "text": "\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "slash separates words",
      "input": "a/b/c\n",
      "keys": "A<C-w><Esc>",
      "expect": {
        "text": "a/b/\n",
        "line": 1,
        "col": 4
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "dash separates words",
      "input": "foo-bar-baz\n",
      "keys": "A<C-w><Esc>",
      "expect": {
        "text": "foo-bar-\n",
        "line": 1,
        "col": 8
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "tab separates words",
      "input": "a\tb\n",
      "keys": "A<C-w><Esc>",
      "expect": {
        "text": "a\t\n",
        "line": 1,
        "col": 2
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w mid-word with nothing typed reaches the word start",
      "input": "foobar\n",
      "keys": "li<C-w><Esc>",
      "expect": {
        "text": "oobar\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w mid-word on a longer word",
      "input": "abcdef\n",
      "keys": "llli<C-w><Esc>",
      "expect": {
        "text": "def\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w mid-word is still walled by typed text",
      "input": "abcdef\n",
      "keys": "llliXY<C-w><Esc>",
      "expect": {
        "text": "abcdef\n",
        "line": 1,
        "col": 3
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w at column 1 of the first line does nothing",
      "input": "abc\n",
      "keys": "0i<C-w><Esc>",
      "expect": {
        "text": "abc\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w takes typed text and restores what it replaced",
      "input": "abcdef\n",
      "keys": "llRXY<C-w>Z<Esc>",
      "expect": {
        "text": "abZdef\n",
        "line": 1,
        "col": 3
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w in replace mode with nothing typed changes no text",
      "input": "abc def\n",
      "keys": "RXY<C-w><C-w><Esc>",
      "expect": {
        "text": "abc def\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w then Esc then u undoes the whole insert",
      "input": "abc def\n",
      "keys": "AXY<C-w><Esc>u",
      "expect": {
        "text": "abc def\n",
        "line": 1,
        "col": 7
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "two C-w then Esc then u undoes the whole insert",
      "input": "foo bar\n",
      "keys": "A<C-w><C-w><Esc>u",
      "expect": {
        "text": "foo bar\n",
        "line": 1,
        "col": 7
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u with nothing typed deletes the whole line",
      "input": "foo bar\n",
      "keys": "A<C-u><Esc>",
      "expect": {
        "text": "\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u deletes only the typed run",
      "input": "foo bar\n",
      "keys": "AXY<C-u><Esc>",
      "expect": {
        "text": "foo bar\n",
        "line": 1,
        "col": 7
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u then typing continues at the insert start",
      "input": "foo bar\n",
      "keys": "AXY<C-u>Z<Esc>",
      "expect": {
        "text": "foo barZ\n",
        "line": 1,
        "col": 8
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "two C-u empty a line that had nothing typed",
      "input": "abc\n",
      "keys": "AXY<C-u><C-u><Esc>",
      "expect": {
        "text": "\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u mid-line with nothing typed reaches the line start",
      "input": "abcdef\n",
      "keys": "llli<C-u><Esc>",
      "expect": {
        "text": "def\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u mid-line is walled by typed text",
      "input": "abcdef\n",
      "keys": "llliXY<C-u><Esc>",
      "expect": {
        "text": "abcdef\n",
        "line": 1,
        "col": 3
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u leaves an indented line's indent alone when nothing is typed",
      "input": "    abc\n",
      "keys": "A<C-u><Esc>",
      "expect": {
        "text": "\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u after a typed line break only clears the new line",
      "input": "abc\n",
      "keys": "A<CR>XY<C-u><Esc>",
      "expect": {
        "text": "abc\n\n",
        "line": 2,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u mid-line deletes to the line start",
      "input": "abc\ndef\n",
      "keys": "jlli<C-u><Esc>",
      "expect": {
        "text": "abc\nf\n",
        "line": 2,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u clears the first line only",
      "input": "abc\ndef\n",
      "keys": "A<C-u><Esc>",
      "expect": {
        "text": "\ndef\n",
        "line": 1,
        "col": 1
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u in replace mode restores what it replaced",
      "input": "abcdef\n",
      "keys": "llRXY<C-u>Z<Esc>",
      "expect": {
        "text": "abZdef\n",
        "line": 1,
        "col": 3
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-u then Esc then u undoes the whole insert",
      "input": "abc def\n",
      "keys": "AXY<C-u><Esc>u",
      "expect": {
        "text": "abc def\n",
        "line": 1,
        "col": 7
      },
      "engines": [
        "vim"
      ]
    },
    {
      "name": "C-w after the host moved the caret one character left",
      "input": "foo bar\n",
      "keys": "A<Left><C-w><Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "foo r\n",
        "line": 1,
        "col": 4
      }
    },
    {
      "name": "C-w after the host moved the caret into the word",
      "input": "foo bar\n",
      "keys": "A<Left><Left><Left><C-w><Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "bar\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "C-w after the host moved the caret forward",
      "input": "foo bar\n",
      "keys": "lli<Right><Right><C-w><Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "fobar\n",
        "line": 1,
        "col": 2
      }
    },
    {
      "name": "C-u after the host moved the caret back over typed text",
      "input": "foo bar\n",
      "keys": "AXY<Left><Left><C-u><Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "XY\n",
        "line": 1,
        "col": 1
      }
    },
    {
      "name": "C-w with the caret left of the typed run",
      "input": "foo bar\n",
      "keys": "AXY<Left><Left><C-w><Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "foo XY\n",
        "line": 1,
        "col": 4
      }
    },
    {
      "name": "typing after a caret move inserts where the caret is",
      "input": "foo bar\n",
      "keys": "AXY<Left><Left>Z<Esc>",
      "engines": [
        "vim"
      ],
      "expect": {
        "text": "foo barZXY\n",
        "line": 1,
        "col": 8
      }
    }
  ]
}
