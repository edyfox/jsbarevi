{
  "name": "jsbarevi",
  "version": "0.1.0",
  "description": "A deliberately barebones vi for browser text fields",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "node tools/stamp-build.mjs && node tools/audit-undo.mjs && node test/dev-server.mjs && node test/cursor.mjs && node test/unit.mjs && node test/editor-session.mjs && node test/pytextfilter-integration.mjs && node test/run-engine-tests.mjs && node test/differential.mjs",
    "test:e2e": "node tools/stamp-build.mjs && node test/e2e-cdp.mjs",
    "test:ext": "node tools/build-extension.mjs --no-zip && node test/extension-e2e.mjs",
    "build:ext": "node tools/build-extension.mjs",
    "icons": "python3 tools/make-icons.py",
    "test:oracle": "python3 oracle/run.py",
    "dev": "node tools/stamp-build.mjs && node tools/dev-server.mjs",
    "patch:pytextfilter": "python3 tools/pytextfilter-add-cors.py",
    "stamp": "node tools/stamp-build.mjs",
    "audit": "python3 tools/emit-target.py && node tools/audit-surface.mjs",
    "audit:align": "node tools/audit-align.mjs",
    "audit:undo": "node tools/audit-undo.mjs",
    "store:shots": "node tools/build-extension.mjs --no-zip && node tools/store-screenshots.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "files": [
    "src",
    "LICENSE",
    "NOTICE",
    "CREDITS.md"
  ]
}
